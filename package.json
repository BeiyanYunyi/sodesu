{
  "name": "sodesu-comment",
  "type": "module",
  "version": "0.6.1",
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "description": "Comment system with Svelte and UnoCSS",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "url": "https://github.com/BeiyanYunyi/sodesu"
  },
  "keywords": [
    "valine",
    "waline",
    "comment",
    "blog",
    "svelte"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/sodesu.mjs",
      "default": "./dist/sodesu.mjs"
    },
    "./sodesu-comment.css": "./dist/sodesu-comment.css",
    "./aio": {
      "types": "./dist/index.d.ts",
      "import": "./dist/sodesu.aio.mjs",
      "require": "./dist/sodesu.aio.umd.cjs",
      "default": "./dist/sodesu.aio.umd.cjs"
    },
    "./preset": {
      "types": "./dist/utils/presetSodesu.d.ts",
      "import": "./dist/preset.js",
      "require": "./dist/preset.cjs",
      "default": "./dist/preset.cjs"
    },
    "./component": {
      "types": "./dist/App.svelte.d.ts",
      "svelte": "./src/App.svelte",
      "import": "./dist/component.js",
      "default": "./dist/component.js"
    },
    "./safeList": {
      "types": "./dist/safeList.d.ts",
      "import": "./dist/safeList.js",
      "require": "./dist/safeList.cjs",
      "default": "./dist/safeList.cjs"
    },
    "./dist/*": "./dist/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "main": "./dist/sodesu.mjs",
  "module": "./dist/sodesu.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "dist/*"
      ]
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "pnpm check && node --import tsx scripts/vBuild.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "oxlint -c .oxlintrc.json",
    "lint:fix": "oxlint -c .oxlintrc.json --fix",
    "format": "oxfmt --disable-nested-config --write .",
    "format:check": "oxfmt --disable-nested-config --check .",
    "check": "svelte-check --tsgo --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:ssr": "node --import tsx scripts/checkSSR.ts",
    "test:build": "node --import tsx scripts/checkBuild.ts && tsc -p tests/tsconfig.consumer.json"
  },
  "peerDependencies": {
    "svelte": "^5.57.3"
  },
  "dependencies": {
    "@waline/api": "1.1.2",
    "@webc.site/math": "^0.1.41"
  },
  "devDependencies": {
    "@giphy/js-types": "^5.1.0",
    "@stackblitz/sdk": "^1.11.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@traptitech/markdown-it-katex": "^3.6.0",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@unocss/core": "^66.12.0",
    "jsdom": "^30.1.3",
    "katex": "^0.19.1",
    "lightningcss": "^1.33.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "rehype-document": "^7.0.3",
    "rehype-format": "^5.0.1",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "starkdown": "^4.0.7",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "svelte2tsx": "^0.7.62",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "unified": "^11.0.5",
    "unocss": "^66.12.0",
    "user-agent-data-types": "^0.4.3",
    "vite": "^8.3.5",
    "vitepress": "1.6.4",
    "vitest": "^5.0.5",
    "vue": "^3.5.44"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  }
}
